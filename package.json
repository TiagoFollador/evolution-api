{
  "name": "nexo-api",
  "version": "0.1.0",
  "description": "Meta Tech Provider messaging gateway for WhatsApp Cloud API, Instagram Direct and Messenger",
  "main": "./dist/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "start": "tsx ./src/main.ts",
    "start:prod": "node dist/main",
    "dev:server": "tsx watch ./src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --fix --ext .ts src",
    "lint:check": "eslint --ext .ts src",
    "commit": "cz",
    "commitlint": "commitlint --edit",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TiagoFollador/evolution-api.git"
  },
  "keywords": [
    "messaging",
    "gateway",
    "meta",
    "tech-provider",
    "whatsapp-cloud-api",
    "instagram-direct",
    "messenger",
    "webhook",
    "multi-tenant"
  ],
  "author": {
    "name": "Tiago Follador",
    "email": "tiagofollador97@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/TiagoFollador/evolution-api/issues"
  },
  "homepage": "https://github.com/TiagoFollador/evolution-api#readme",
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix"
    ],
    "src/**/*.ts": [
      "sh -c 'tsc --noEmit'"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^10.12.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.9",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "emoji-regex": "^10.4.0",
    "eventemitter2": "^6.4.9",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fetch-socks": "^1.3.2",
    "form-data": "^4.0.1",
    "https-proxy-agent": "^7.0.6",
    "i18next": "^23.7.19",
    "json-schema": "^0.4.0",
    "jsonschema": "^1.4.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.25",
    "mime-types": "^2.1.35",
    "minio": "^8.0.3",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "prisma": "^6.1.0",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "socks-proxy-agent": "^8.0.5",
    "tsup": "^8.3.5",
    "undici": "^7.16.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.18",
    "@types/json-schema": "^7.0.15",
    "@types/mime": "^4.0.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.4.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
